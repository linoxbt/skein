{
  "name": "skein",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run typecheck",
    "policies:lock": "pnpm --filter @skein/policies lock",
    "verdict": "pnpm --silent --filter @skein/pipeline verdict",
    "repro": "pnpm --silent --filter @skein/pipeline repro",
    "dev:api": "pnpm --filter @skein/api dev",
    "dev:web": "pnpm --filter @skein/web dev"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
