{
  "name": "@skeinlabs/sdk",
  "version": "0.3.1",
  "type": "module",
  "description": "TypeScript client for Skein token listing verdicts: verdict(), quote(), verify(), stream(), typed errors, retries and a spend cap checked before any payment. Pays with a partner key, per call through Telegraph, or per call with x402.",
  "exports": {
    ".": "./src/index.ts",
    "./telegraph": "./src/telegraph.ts",
    "./attest": "./src/attest.ts",
    "./webhooks": "./src/webhooks.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --hookTimeout=120000 --testTimeout=120000",
    "build": "tsup",
    "check:published": "node scripts/check-published.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "prepublishOnly": "node scripts/require-pnpm.mjs && tsup"
  },
  "devDependencies": {
    "@skein/api": "workspace:*",
    "@skein/engine": "workspace:*",
    "@skein/telegraph": "workspace:*",
    "tsup": "8.5.0",
    "typescript": "5.9.3",
    "viem": "2.57.5"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/linoxbt/skein",
    "directory": "packages/sdk"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "typesVersions": {
      "*": {
        "telegraph": [
          "./dist/telegraph.d.ts"
        ],
        "attest": [
          "./dist/attest.d.ts"
        ],
        "webhooks": [
          "./dist/webhooks.d.ts"
        ]
      }
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./telegraph": {
        "types": "./dist/telegraph.d.ts",
        "import": "./dist/telegraph.js"
      },
      "./attest": {
        "types": "./dist/attest.d.ts",
        "import": "./dist/attest.js"
      },
      "./package.json": "./package.json",
      "./webhooks": {
        "types": "./dist/webhooks.d.ts",
        "import": "./dist/webhooks.js"
      }
    }
  },
  "keywords": [
    "skein",
    "telegraph",
    "token",
    "listing",
    "risk",
    "verdict",
    "fraud",
    "x402",
    "agents",
    "web3",
    "evm"
  ],
  "author": "Skein Labs (https://skeinlabs.site)",
  "homepage": "https://skeinlabs.site/tutorial",
  "bugs": {
    "url": "https://github.com/linoxbt/skein/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "peerDependencies": {
    "viem": "^2.30.0"
  },
  "peerDependenciesMeta": {
    "viem": {
      "optional": true
    }
  }
}
