{
  "name": "@skeinlabs/mcp",
  "version": "0.1.1",
  "type": "module",
  "description": "Skein as an MCP server for LLM agents (Claude, Cursor, any MCP client): skein_verdict, skein_quote and skein_verify, with a per-call and per-session spend cap.",
  "exports": {
    ".": "./src/server.ts"
  },
  "bin": {
    "skein-mcp": "./bin/skein-mcp.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --hookTimeout=120000 --testTimeout=120000",
    "start": "tsx bin/skein-mcp.ts",
    "build": "tsup",
    "prepublishOnly": "tsup"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@skeinlabs/sdk": "workspace:^",
    "viem": "2.57.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@skein/api": "workspace:*",
    "tsup": "8.5.0",
    "typescript": "5.9.3"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/linoxbt/skein",
    "directory": "packages/mcp"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "bin": {
      "skein-mcp": "./dist/skein-mcp.js"
    },
    "exports": {
      ".": {
        "types": "./dist/server.d.ts",
        "import": "./dist/server.js"
      }
    }
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "cursor",
    "agents",
    "skein",
    "telegraph",
    "token",
    "listing",
    "risk"
  ],
  "author": "Skein Labs (https://skeinlabs.site)",
  "homepage": "https://skeinlabs.site/tutorial",
  "bugs": {
    "url": "https://github.com/linoxbt/skein/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
