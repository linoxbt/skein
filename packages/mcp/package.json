    "test": "vitest run",
    "start": "tsx bin/skein-mcp.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@skein/sdk": "workspace:*",
    "@skein/telegraph": "workspace:*",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@skein/api": "workspace:*"
  }
}
