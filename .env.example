# Every variable the code reads, by service. Secrets go in the host's secret
# store (Railway, Netlify), never in a file in the repo.

# ── API (Railway) ─────────────────────────────────────────────────────────────
DATABASE_URL=                     # Postgres; Railway's private network or local
DATABASE_CA_CERT=                 # PEM root, only for a provider with its own CA (Supabase)
PORT=8080
PURCHASER_PRIVATE_KEY=            # burner hot wallet that pays upstream miners (secret)
MINER_AUTH_KEY=                   # what the Telegraph dispatcher presents on /miner/verdict (secret)
SKEIN_ATTESTATION_KEY=            # signs every verdict (EIP-191); holds no funds; its address is at /v1/status (secret)
SEED_CONSUMERS=                   # partner keys by hash: "name|kind|sha256|capUsdc,..." (reconciled on start)
REVOKED_KEY_HASHES=               # sha256 of partner keys to refuse, comma-separated
RATE_LIMIT_STORE=postgres         # postgres: shared by every replica (default); memory: one process only
KV_KEY_HASHES=                    # sha256 of partner keys allowed to use /v1/kv (Skein Desk's store), comma-separated
SKEIN_SELF_REGISTRATION_IDS=      # Skein's own miner registration ids, never bought from
WEB_ORIGINS=https://skeinlabs.site,https://www.skeinlabs.site,https://skein-web.netlify.app   # browser origins allowed by CORS
DEFAULT_POLICY=dex-list
NETWORK_LABEL=                    # only "simulated" for the local fake-node stack
ALLOW_PRE_SEASON=false            # never true in production

# Network (from the live 402 challenge and the Addresses page; every challenge is checked against them)
TELEGRAPH_NODE_URL=https://devnode.telegraphprotocol.com
TELEGRAPH_CHAIN_ID=11155111
TELEGRAPH_CAIP2=eip155:11155111
TELEGRAPH_DIAMOND=0x3624EB012B5E998BB57B6bE6C9Cfc9c4bc5eb99b
TELEGRAPH_USDC=0xcc194e1a843B658526D0D5C431f670028582Ae17
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Money (USDC)
SKEIN_PRICE_USDC=0.25             # list price per verdict; ABSTAIN is charged at upstream cost
DAILY_CAP_USDC=10                 # all upstream spend in a UTC day, every channel (held atomically)
PER_VERDICT_CAP_USDC=0.20
MAX_USDC_PER_CALL=0.05            # no single 402 is signed above this
SPOTCHECK_DAILY_CAP_USDC=2        # uncached Telegraph requests, per day (D5)
HOT_WALLET_ALERT_USDC=2           # /v1/status alerts below this wallet balance
X402_PAY_TO=                      # optional: turns on x402 pay-per-verdict on POST /v1/verdicts; payments go to this address
X402_NETWORK=base-sepolia         # base-sepolia (default) or base
X402_PRICE_USDC=0.25              # what one x402 verdict costs
X402_DAILY_CAP_USDC=5             # upstream spend all x402 callers together may cause per UTC day
X402_FACILITATOR_URL=https://x402.org/facilitator   # verifies and settles payments (testnets); use a mainnet facilitator on base
SENTRY_DSN=                       # optional: error tracking (Sentry or any Sentry-compatible service); same variable on the API, Desk and sniper
ALERT_WEBHOOK_URL=                # optional: a Slack or Discord webhook that receives wallet-low, 80%-of-cap and lost-run alerts

# Timing
CACHE_TTL_SEC=600
CACHE_REFRESH_MIN_AGE_SEC=480     # a cache hit older than this refreshes in the background (D5)
SYNC_TIMEOUT_MS=25000
VERDICT_DEADLINE_MS=90000
MINER_DEADLINE_MS=25000
TRUST_PROXY_HOPS=1                # proxies appending to X-Forwarded-For (Railway: 1)
EVENT_RETENTION_DAYS=7

# ── Web (Netlify, build time) ─────────────────────────────────────────────────
NEXT_PUBLIC_SKEIN_API=https://api.skeinlabs.site                  # a Netlify build fails without it

# ── Skein Desk (Netlify) ──────────────────────────────────────────────────────
SKEIN_API_URL=https://api.skeinlabs.site
SKEIN_WEB_URL=https://skeinlabs.site
NEXT_PUBLIC_SKEIN_WEB_URL=https://skeinlabs.site
DESK_PAYER=apiKey                 # apiKey or telegraph
DESK_SKEIN_KEY=                   # the Desk's partner key (secret; apiKey rail)
DESK_PAYER_KEY=                   # a burner with escrow funds (secret; telegraph rail)
SKEIN_MINER_ID=                   # pin Skein's miner on Telegraph
DESK_MAX_USDC_PER_CALL=0.30
DESK_CRON_SECRET=                 # the scheduled tick's bearer secret (secret)
DESK_WEBHOOK_SECRET=              # for applications posted by webhook (secret)
DESK_DAILY_APPLICATIONS=20        # public form applications a day: at most 20 x 0.13 = 2.6 USDC of verdicts
DESK_DAILY_PER_IP=5
DESK_STORE=                       # blobs | file | memory (default: blobs on Netlify, file in dev)
DESK_DATA_DIR=.desk-data

# ── MCP server (stdio, the user's machine) ────────────────────────────────────
SKEIN_API_KEY=                    # or SKEIN_PAYER_KEY for the Telegraph rail
SKEIN_PAYER_KEY=
SKEIN_MAX_USDC_PER_CALL=0.30
SKEIN_SESSION_CAP_USDC=2

# ── Miner registration (miner/tools.ts; run by hand) ─────────────────────────
MINER_REGISTRATION_KEY=           # cold key that owns the registration
VALIDATOR_URL=                    # the YAML validator, when the default 404s
