# Every variable the code reads, by service. Secrets go in the host's secret
# store (Railway, Netlify), never in a file in the repo.

# ── API (Railway) ─────────────────────────────────────────────────────────────
DATABASE_URL=                     # Postgres; Railway's private network or local
DATABASE_CA_CERT=                 # PEM root, only for a provider with its own CA (Supabase)
PORT=8080
PURCHASER_PRIVATE_KEY=            # burner hot wallet that pays upstream miners (secret)
MINER_AUTH_KEY=                   # what the Telegraph dispatcher presents on /miner/verdict (secret)
SKEIN_ATTESTATION_KEY=            # signs every verdict (EIP-191); holds no funds; its address is at /v1/status (secret)
SEED_CONSUMERS=                   # partner keys by hash: "name|kind|sha256|capUsdc,..." (reconciled on start)
REVOKED_KEY_HASHES=               # sha256 of partner keys to refuse, comma-separated
RATE_LIMIT_STORE=postgres         # postgres: shared by every replica (default); memory: one process only
KV_KEY_HASHES=                    # sha256 of partner keys allowed to use /v1/kv (Skein Desk's store), comma-separated
ADMIN_KEY_HASHES=                 # sha256 of admin keys: they manage every key at /admin (/v1/admin/keys) and buy nothing
SELF_SERVE_KEYS=on                # off: no self-serve keys (POST /v1/keys); a wallet signs in for one at /keys
SELF_SERVE_DAILY_CAP_USDC=0.5     # each self-serve key's daily cap on upstream spend
SELF_SERVE_TOTAL_DAILY_USDC=3     # what every self-serve key together may spend upstream a UTC day
SKEIN_SELF_REGISTRATION_IDS=      # Skein's own miner registration ids, never bought from
WEB_ORIGINS=https://skeinlabs.site,https://www.skeinlabs.site,https://skein-web.netlify.app   # browser origins allowed by CORS
DEFAULT_POLICY=dex-list
NETWORK_LABEL=                    # only "simulated" for the local fake-node stack
ALLOW_PRE_SEASON=false            # never true in production
SKEIN_API_URL=https://api.skeinlabs.site   # the API's public origin; the x402 resource URL is built from it
SUBJECT_RPC_URLS=                 # optional: chainId=https://rpc,... ; a subject with no code there is refused (not a contract)
MIGRATION_WAIT_MS=100000          # how long a replica waits for the migrate job; stay below the 120 s healthcheck
WEBHOOK_SECRET_KEY=               # 32 bytes, hex or base64: encrypts webhook secrets at rest (secret; recommended)

# Network (from the live 402 challenge and the Addresses page; every challenge is checked against them)
TELEGRAPH_NODE_URL=https://devnode.telegraphprotocol.com
TELEGRAPH_CHAIN_ID=11155111
TELEGRAPH_CAIP2=eip155:11155111
TELEGRAPH_DIAMOND=0x3624EB012B5E998BB57B6bE6C9Cfc9c4bc5eb99b
TELEGRAPH_USDC=0xcc194e1a843B658526D0D5C431f670028582Ae17
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
TELEGRAPH_ALLOW_MAINNET=          # 1 to allow a non-testnet TELEGRAPH_CHAIN_ID (refused otherwise)

# Money (USDC)
SKEIN_PRICE_USDC=0.25             # list price per verdict; ABSTAIN is charged at upstream cost
DAILY_CAP_USDC=10                 # all upstream spend in a UTC day, every channel (held atomically)
PER_VERDICT_CAP_USDC=0.20
MAX_USDC_PER_CALL=0.05            # no single 402 is signed above this
SPOTCHECK_DAILY_CAP_USDC=2        # uncached Telegraph requests, per day (D5)
HOT_WALLET_ALERT_USDC=2           # /v1/status alerts below this wallet balance
HOT_WALLET_PAUSE_USDC=0.05        # below this escrow balance verdicts pause (503 WALLET_EMPTY, /v1/status paused)
GLOBAL_CAP_STOP_PCT=80            # purchases stop at this share of DAILY_CAP_USDC (alert at the same point)
X402_PAY_TO=                      # optional: turns on x402 pay-per-verdict on POST /v1/verdicts; payments go to this address
X402_NETWORK=base-sepolia         # base-sepolia (default) or base
X402_PRICE_USDC=                  # optional; must equal SKEIN_PRICE_USDC (startup refuses a mismatch)
X402_DAILY_CAP_USDC=5             # upstream spend all x402 callers together may cause per UTC day
X402_FACILITATOR_URL=https://x402.org/facilitator   # verifies and settles payments (testnets); use a mainnet facilitator on base
X402_ASSET=                       # optional: the USDC contract on X402_NETWORK (default: Circle's USDC there)
X402_RESOURCE_URL=                # optional: the resource named in the 402 (default SKEIN_API_URL + /v1/verdicts)
X402_PAYER_PER_MINUTE=10          # x402 requests per payer address per minute
X402_PAYER_DAILY_MAX=20           # x402 verdicts per payer address per UTC day
SENTRY_DSN=                       # optional: error tracking (Sentry or any Sentry-compatible service); same variable on the API, Desk and sniper
ALERT_WEBHOOK_URL=                # api and probe: comma-separated ntfy topic URL (https://ntfy.sh/<topic>), Slack or Discord webhooks
DB_RUNTIME_ROLE=                  # local stack: empty migrates as owner then queries as skein_app; "owner" keeps the owner connection
DATABASE_MIGRATIONS=              # production: "external" = DATABASE_URL is skein_app's and the migrate job (src/migrate.ts) migrates
DB_APP_PASSWORD=                  # migrate job (and local stack): skein_app's password, 32+ chars
DB_SNIPER_PASSWORD=               # migrate job: skein_sniper's password
DATABASE_POOL_MAX=20              # connections per API replica

# Timing
CACHE_TTL_SEC=600
CACHE_REFRESH_MIN_AGE_SEC=480     # a cache hit older than this refreshes in the background (D5)
SYNC_TIMEOUT_MS=25000
VERDICT_DEADLINE_MS=90000
MINER_DEADLINE_MS=25000
TRUST_PROXY_HOPS=1                # proxies appending to X-Forwarded-For (Railway: 1)
EVENT_RETENTION_DAYS=7

# ── Web (Netlify, build time) ─────────────────────────────────────────────────
NEXT_PUBLIC_SKEIN_API=
NEXT_PUBLIC_SITE_URL=https://skeinlabs.site   # canonical URL for metadata and share links
NEXT_PUBLIC_TELEGRAPH_NODE_URL=https://devnode.telegraphprotocol.comhttps://api.skeinlabs.site                  # a Netlify build fails without it

# ── Skein Desk (Netlify) ──────────────────────────────────────────────────────
SKEIN_API_URL=https://api.skeinlabs.site
SKEIN_WEB_URL=https://skeinlabs.site
NEXT_PUBLIC_SKEIN_WEB_URL=https://skeinlabs.site
DESK_PAYER=telegraph              # telegraph (production: every verdict is a paid Telegraph ask) or apiKey
DESK_SKEIN_KEY=                   # the Desk's partner key (secret; apiKey rail)
DESK_PAYER_KEY=                   # a burner with escrow funds (secret; telegraph rail)
SKEIN_MINER_ID=845301             # Skein's miner on Telegraph (catalogue id); "routed" lets the node choose
DESK_MAX_USDC_PER_CALL=0.30
DESK_INTENT=FRAUD_RISK_GENERAL    # the intent Skein serves (plan B)
DESK_TELEGRAPH_TIMEOUT_MS=45000   # one paid ask, end to end
DESK_AUTO_DAILY=1                 # launches the agent files itself per UTC day (autonomous intake)
DESK_AUTO_SOURCES=dexscreener,sniper
DESK_SNIPER_FEED_URL=https://sniper-production-bea6.up.railway.app/feed.json
DESK_TELEGRAPH_FORM_DAILY=1       # form/webhook applications bought on Telegraph per day; the rest use the partner key
DESK_CRON_SECRET=                 # the scheduled tick's bearer secret (secret)
DESK_WEBHOOK_SECRET=              # for applications posted by webhook (secret)
DESK_DAILY_APPLICATIONS=20        # public form applications a day: at most 20 x 0.13 = 2.6 USDC of verdicts
DESK_DAILY_PER_IP=5
DESK_STORE=                       # blobs | file | memory (default: blobs on Netlify, file in dev)
DESK_DATA_DIR=.desk-data

# ── MCP server (stdio, the user's machine) ────────────────────────────────────
SKEIN_API_KEY=                    # or SKEIN_PAYER_KEY for the Telegraph rail
SKEIN_PAYER_KEY=
SKEIN_MAX_USDC_PER_CALL=0.30      # finite and above 0, or the server exits
SKEIN_SESSION_CAP_USDC=2          # per process (SKEIN_DAILY_CAP_USDC is a deprecated alias)
SKEIN_INTENT=FRAUD_RISK_GENERAL   # Telegraph rail
SKEIN_API_KEY_BILLING=list        # list | free: how a partner-key verdict counts against the session cap

# ── Skein Sniper (Railway) ────────────────────────────────────────────────────
SNIPER_SKEIN_KEY=                 # a partner key (apiKey rail; secret), or
SNIPER_PAYER_KEY=                 # a funded Telegraph burner (secret)
SNIPER_INTENT=FRAUD_RISK_GENERAL
SNIPER_MINER_ID=845301
SKEIN_ATTESTER=                   # Skein's signer address; pin it (otherwise read from /v1/status, or the sniper refuses to start)
BASE_RPC_URL=https://base-rpc.publicnode.com
SNIPER_POLICY=agent-pretrade@0.3.0
SNIPER_MIN_LIQUIDITY_USD=50000    # raised to the policy's liquidity_depth FAIL threshold if lower
SNIPER_MIN_AGE_MIN=
SNIPER_MAX_AGE_MIN=
SNIPER_DAILY_CHECKS=40            # verdicts per UTC day, failures included
SNIPER_DAILY_USDC=12              # USDC per UTC day, paid failures and in-flight asks included
SNIPER_MAX_USDC_PER_CALL=
SNIPER_TICKET_USD=
SNIPER_TICK_SEC=

# ── Probe (Railway cron, every 10 min) ────────────────────────────────────────
PROBE_API_URL=https://api.skeinlabs.site
PROBE_WEB_URL=https://skeinlabs.site
PROBE_DESK_URL=https://desk.skeinlabs.site
PROBE_SNIPER_URL=https://sniper-production-bea6.up.railway.app
SKEIN_MINER_REGISTRATION=5137
PROBE_BACKUP_MAX_AGE_H=26
PROBE_MIN_VERDICTS=5
PROBE_MAX_ABSTAIN_SHARE=0.5
PROBE_MIN_PURCHASES=10
PROBE_MAX_PURCHASE_ERROR_SHARE=0.5
PROBE_MAX_P95_MS=10000

# ── Backup (Railway cron, daily) ──────────────────────────────────────────────
BUCKET=                           # s3 bucket for dumps (AWS_* credentials are secrets)
KEEP=30
BACKUP_AGE_RECIPIENT=             # age public key: dumps are encrypted to it (keep the identity offline)
# restore drill only: RESTORE_DATABASE_URL, BACKUP_AGE_IDENTITY (docs/RUNBOOK.md, Backups)

# ── Miner registration (miner/tools.ts; run by hand) ─────────────────────────
MINER_REGISTRATION_KEY=           # cold key that owns the registration
VALIDATOR_URL=                    # the YAML validator, when the default 404s
