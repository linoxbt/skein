# Network. Defaults (packages/telegraph/src/config.ts) are the testnet values
# from the docs' Addresses page on 2026-10-30; every 402 challenge is checked
# against them and refused if it disagrees.
TELEGRAPH_NODE_URL=https://devnode.telegraphprotocol.com
TELEGRAPH_CHAIN_ID=11155111
TELEGRAPH_CAIP2=eip155:11155111
TELEGRAPH_DIAMOND=0x3624EB012B5E998BB57B6bE6C9Cfc9c4bc5eb99b
TELEGRAPH_USDC=0xcc194e1a843B658526D0D5C431f670028582Ae17
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Wallets and keys (secret store only)
PURCHASER_PRIVATE_KEY=
MINER_AUTH_KEY=
X402_PAYTO_ADDRESS=          # where direct-API payments land
FEE_ADDRESS=                 # MACHINA payouts, cold

# Limits
DAILY_CAP_USDC=10
PER_VERDICT_CAP_USDC=0.20
HOT_WALLET_ALERT_USDC=2
# Validator spot checks: a separate daily cap, and no background refresh of a
# cached verdict younger than this (docs/DECISIONS.md, D5).
SPOTCHECK_DAILY_CAP_USDC=2
CACHE_REFRESH_MIN_AGE_SEC=480

# App
DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SKEIN_SELF_REGISTRATION_IDS=
WEBHOOK_SIGNING_SECRET=
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
